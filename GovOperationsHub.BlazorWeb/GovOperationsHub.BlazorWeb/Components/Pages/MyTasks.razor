@page "/my-tasks"
@attribute [Authorize]
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@rendermode InteractiveServer

<PageTitle>صندوق المهام (My Tasks)</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="text-primary fw-bold">📥 صندوق المهام الموجهة (Inbox)</h3>
    <button class="btn btn-outline-primary" @onclick="LoadTasks">
        <i class="bi bi-arrow-clockwise"></i> تحديث الصندوق
    </button>
</div>

@if (!string.IsNullOrEmpty(globalMessage))
{
    <div class="alert @(isSuccessMessage ? "alert-success" : "alert-danger") alert-dismissible fade show shadow-sm" role="alert">
        @globalMessage
        <button type="button" class="btn-close" @onclick="() => globalMessage = string.Empty"></button>
    </div>
}

@if (tasks == null)
{
    <div class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 fw-bold text-muted">جاري تحميل المهام...</p>
    </div>
}
else if (!tasks.Any())
{
    <div class="alert alert-success text-center py-5 shadow-sm border-0 mt-4">
        <h1 class="display-1 text-success mb-3">🎉</h1>
        <h4 class="fw-bold">صندوق المهام فارغ!</h4>
        <p class="text-muted">لا يوجد لديك أي مهام معلقة في الوقت الحالي.</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var task in tasks)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 border-start border-4 @GetBorderColor(task.RemainingDays)">
                    <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between">
                        <span class="badge bg-secondary">عقد: @task.ContractNumber</span>
                        <span class="badge bg-info text-dark">ملحق: @task.AnnexNumber</span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-primary fw-bold mb-3">@task.StageName</h5>
                        <p class="card-text mb-1 text-dark">
                            <i class="bi bi-building me-2 text-muted"></i>
                            <strong>المركز:</strong> @task.CenterName
                        </p>
                        <p class="card-text mb-3 text-dark">
                            <i class="bi bi-calendar-event me-2 text-muted"></i>
                            <strong>الموعد المتوقع:</strong> <span dir="ltr">@task.ExpectedCompletionDate.ToString("yyyy-MM-dd")</span>
                        </p>

                        <div class="d-flex align-items-center mt-3">
                            @if (task.RemainingDays < 0)
                            {
                                <span class="badge bg-danger p-2 w-100 fs-6">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> متأخرة بـ @Math.Abs(task.RemainingDays) يوم!
                                </span>
                            }
                            else if (task.RemainingDays <= 2)
                            {
                                <span class="badge bg-warning text-dark p-2 w-100 fs-6">
                                    <i class="bi bi-hourglass-split me-1"></i> اقترب الموعد (@task.RemainingDays يوم)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success p-2 w-100 fs-6">
                                    <i class="bi bi-check-circle me-1"></i> الوقت متاح (@task.RemainingDays يوم)
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pb-3">
                        <button class="btn btn-primary w-100 fw-bold shadow-sm" @onclick="() => PrepareComplete(task)">
                            ✅ تسجيل إنجاز المهمة
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (showCompleteModal && selectedTask != null)
{
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">تأكيد الإنجاز</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body bg-light">
                    <div class="alert alert-info">
                        <strong>المهمة:</strong> @selectedTask.StageName<br />
                        <strong>المركز:</strong> @selectedTask.CenterName
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">ملاحظات الإنجاز</label>
                        <textarea class="form-control" rows="3" @bind="taskNotes"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">إلغاء</button>
                    <button type="button" class="btn btn-success px-4 fw-bold" @onclick="ConfirmComplete" disabled="@isSaving">
                        @(isSaving ? "جاري الحفظ..." : "تأكيد وإغلاق المهمة")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<PendingTaskDto>? tasks;
    private bool showCompleteModal = false;
    private PendingTaskDto? selectedTask;
    private string taskNotes = string.Empty;
    private bool isSaving = false;
    private string globalMessage = string.Empty;
    private bool isSuccessMessage = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var roles = authState.User.Claims
                .Where(c => c.Type.Contains("role", StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Value)
                .ToList();

            if (!roles.Any())
            {
                tasks = new List<PendingTaskDto>();
                return;
            }

            var rolesParam = Uri.EscapeDataString(string.Join(",", roles));
            var url = $"api/Tasks/my-pending?roles={rolesParam}";

            var response = await Http.GetAsync(url);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ResultModel<List<PendingTaskDto>>>();
                tasks = result?.Data ?? new List<PendingTaskDto>();
            }
            else
            {
                ShowMessage($"فشل الطلب. رمز الخطأ: {(int)response.StatusCode}", false);
                tasks = new List<PendingTaskDto>();
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطأ: {ex.Message}", false);
            tasks = new List<PendingTaskDto>();
        }
    }

    private void PrepareComplete(PendingTaskDto task)
    {
        selectedTask = task;
        taskNotes = string.Empty;
        showCompleteModal = true;
        globalMessage = string.Empty;
    }

    private void CloseModal()
    {
        showCompleteModal = false;
        selectedTask = null;
    }

    private async Task ConfirmComplete()
    {
        if (selectedTask == null) return;
        isSaving = true;

        try
        {
            var command = new CompleteTaskCommandDto { TaskId = selectedTask.TaskId, Notes = taskNotes };
            var response = await Http.PostAsJsonAsync($"api/Tasks/{selectedTask.TaskId}/complete", command);

            if (response.IsSuccessStatusCode)
            {
                ShowMessage("تم إنجاز المهمة بنجاح!", true);
                CloseModal();
                await LoadTasks();
            }
            else
            {
                ShowMessage("حدث خطأ أثناء الحفظ.", false);
                CloseModal();
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"خطأ: {ex.Message}", false);
            CloseModal();
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetBorderColor(int remainingDays)
    {
        if (remainingDays < 0) return "border-danger";
        if (remainingDays <= 2) return "border-warning";
        return "border-success";
    }

    private void ShowMessage(string message, bool isSuccess)
    {
        globalMessage = message;
        isSuccessMessage = isSuccess;
    }

    public class PendingTaskDto
    {
        public int TaskId { get; set; }
        public string ContractNumber { get; set; } = string.Empty;
        public string AnnexNumber { get; set; } = string.Empty;
        public string CenterName { get; set; } = string.Empty;
        public string StageName { get; set; } = string.Empty;
        public DateTime ExpectedCompletionDate { get; set; }
        public int TrackNumber { get; set; }
        public int RemainingDays => (ExpectedCompletionDate.Date - DateTime.UtcNow.Date).Days;
    }

    public class CompleteTaskCommandDto
    {
        public int TaskId { get; set; }
        public string? Notes { get; set; }
    }

    public class ResultModel<T>
    {
        public bool Succeeded { get; set; }
        public string? Message { get; set; }
        public T? Data { get; set; }
    }
}